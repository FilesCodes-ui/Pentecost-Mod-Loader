<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Pentecost.Manager">
        <SolidColorBrush x:Key="Bg" Color="#0B0B0C"/>
        <SolidColorBrush x:Key="Side" Color="#070708"/>
        <SolidColorBrush x:Key="Panel" Color="#121214"/>
        <SolidColorBrush x:Key="Panel2" Color="#19191C"/>
        <SolidColorBrush x:Key="Line" Color="#242428"/>
        <SolidColorBrush x:Key="Edge" Color="#3A3A40"/>
        <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Soft" Color="#B8B8BE"/>
        <SolidColorBrush x:Key="Muted" Color="#8A8A92"/>
        <SolidColorBrush x:Key="Faint" Color="#6E6E76"/>
        <SolidColorBrush x:Key="Hover" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Ok" Color="#8FD6A0"/>
        <SolidColorBrush x:Key="Warn" Color="#E2B86B"/>
        <SolidColorBrush x:Key="Bad" Color="#E5736B"/>

        <DropShadowEffect x:Key="Glow" Color="White" BlurRadius="14" ShadowDepth="0" Opacity="0.28"/>

        <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        </Style>

        <Style x:Key="ButtonBase" TargetType="ButtonBase">
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:PixelBox x:Name="Box" Padding="{TemplateBinding Padding}">
                            <local:PixelBox.Background><SolidColorBrush Color="#E6E6E6"/></local:PixelBox.Background>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="#0A0A0B"/>
                        </local:PixelBox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Background.Color" To="#FFFFFF" Duration="0:0:0.1"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Background.Color" To="#E6E6E6" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:PixelBox x:Name="Box" Padding="{TemplateBinding Padding}" BorderThickness="1">
                            <local:PixelBox.Background><SolidColorBrush Color="#00FFFFFF"/></local:PixelBox.Background>
                            <local:PixelBox.BorderBrush><SolidColorBrush Color="#3A3A40"/></local:PixelBox.BorderBrush>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="#F2F2F2"/>
                        </local:PixelBox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Background.Color" To="#16FFFFFF" Duration="0:0:0.1"/>
                                    <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="BorderBrush.Color" To="#B8B8BE" Duration="0:0:0.1"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Background.Color" To="#00FFFFFF" Duration="0:0:0.18"/>
                                    <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="BorderBrush.Color" To="#3A3A40" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:PixelBox x:Name="Box" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="#8A8A92"/>
                        </local:PixelBox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#F2F2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:PixelBox x:Name="Box" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#8A8A92"/>
                        </local:PixelBox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1AE5736B"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#E5736B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:PixelBox x:Name="Box" Background="Transparent">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#8A8A92"/>
                        </local:PixelBox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#F2F2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#6E6E76"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#C8C8CE"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#F2F2F2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Seg" TargetType="RadioButton" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#8A8A92"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <local:PixelBox x:Name="Box" BorderThickness="1" Padding="13,6" Margin="0,0,4,0" BorderBrush="#2A2A2F" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </local:PixelBox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F2F2F2"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#5C5C64"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E6E6E6"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#E6E6E6"/>
                                <Setter Property="Foreground" Value="#0A0A0B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Foreground" Value="#8A8A92"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <local:PixelBox x:Name="Box" BorderThickness="1" Padding="11,5" BorderBrush="#2A2A2F" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </local:PixelBox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F2F2F2"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#5C5C64"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#F2F2F2"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#F2F2F2"/>
                                <Setter TargetName="Box" Property="Background" Value="#1CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tick" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="8">
                            <Border x:Name="Box" Width="16" Height="16" BorderThickness="1" BorderBrush="#5C5C64" Background="Transparent">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#0A0A0B" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#B8B8BE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F2F2F2"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#F2F2F2"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="#66FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <local:PixelBox x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </local:PixelBox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Edge}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#B8B8BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb"><Border Background="#3A3A40" Margin="2,0"/></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb"><Border Background="#3A3A40" Margin="0,2"/></ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="38" Height="20" BorderThickness="1" VerticalAlignment="Center">
                                <Border.BorderBrush><SolidColorBrush Color="#5C5C64"/></Border.BorderBrush>
                                <Border.Background><SolidColorBrush Color="#00FFFFFF"/></Border.Background>
                                <Border x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                    <Border.Background><SolidColorBrush Color="#5C5C64"/></Border.Background>
                                </Border>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin" To="21,0,0,0" Duration="0:0:0.14">
                                        <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                    <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Background.Color" To="#0A0A0B" Duration="0:0:0.14"/>
                                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color" To="#F2F2F2" Duration="0:0:0.14"/>
                                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="BorderBrush.Color" To="#F2F2F2" Duration="0:0:0.14"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin" To="3,0,0,0" Duration="0:0:0.14">
                                        <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                    <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Background.Color" To="#5C5C64" Duration="0:0:0.14"/>
                                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color" To="#00FFFFFF" Duration="0:0:0.14"/>
                                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="BorderBrush.Color" To="#5C5C64" Duration="0:0:0.14"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root" ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="#26262C"/>
                            <Border x:Name="PART_Indicator" Background="#F2F2F2" HorizontalAlignment="Left"/>
                            <Border x:Name="Runner" Width="90" Background="#F2F2F2" HorizontalAlignment="Left" Visibility="Collapsed">
                                <Border.RenderTransform><TranslateTransform x:Name="RunnerMove" X="-90"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="Runner" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="Sliding">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="RunnerMove" Storyboard.TargetProperty="X"
                                                             From="-90" To="1400" Duration="0:0:1.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Sliding"/></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#19191C"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/>
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>
    </ResourceDictionary>
