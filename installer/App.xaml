<Application x:Class="Pentecost.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- The game's palette (Ui.java): near black, white text, one hairline, nothing else. -->
        <Color x:Key="BgColor">#0A0A0B</Color>
        <Color x:Key="TextColor">#F2F2F2</Color>
        <Color x:Key="FaintColor">#636363</Color>
        <SolidColorBrush x:Key="Bg" Color="#0A0A0B"/>
        <SolidColorBrush x:Key="Line" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="Edge" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Soft" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="Muted" Color="#9A9A9A"/>
        <SolidColorBrush x:Key="Faint" Color="#636363"/>
        <SolidColorBrush x:Key="Hover" Color="#0DFFFFFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Small capital labels, like the section names in the game's settings. -->
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- Buttons are an outline that fills white while the mouse is over them, the same as in the game. -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="30,11"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <Border.Background><SolidColorBrush Color="#00F2F2F2"/></Border.Background>
                            <Border.BorderBrush><SolidColorBrush Color="#B3FFFFFF"/></Border.BorderBrush>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="NoWrap">
                                <TextBlock.Foreground><SolidColorBrush Color="#F2F2F2"/></TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Background.Color" To="#FFF2F2F2" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="BorderBrush.Color" To="#FFF2F2F2" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Foreground.Color" To="#FF0A0A0B" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Background.Color" To="#00F2F2F2" Duration="0:0:0.16"/>
                                            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="BorderBrush.Color" To="#B3FFFFFF" Duration="0:0:0.16"/>
                                            <ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Foreground.Color" To="#FFF2F2F2" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Padding" Value="24,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <Border.Background><SolidColorBrush Color="#00F2F2F2"/></Border.Background>
                            <Border.BorderBrush><SolidColorBrush Color="#66FFFFFF"/></Border.BorderBrush>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="NoWrap">
                                <TextBlock.Foreground><SolidColorBrush Color="#F2F2F2"/></TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Background.Color" To="#FFF2F2F2" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="BorderBrush.Color" To="#FFF2F2F2" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Foreground.Color" To="#FF0A0A0B" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Background.Color" To="#00F2F2F2" Duration="0:0:0.16"/>
                                            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="BorderBrush.Color" To="#66FFFFFF" Duration="0:0:0.16"/>
                                            <ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Foreground.Color" To="#FFF2F2F2" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chrome" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The game's slide switch (Ui.toggle): an outline with a square that glides across and goes white when it is on. -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="38" Height="19" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,16,0">
                                <Border.BorderBrush><SolidColorBrush Color="#636363"/></Border.BorderBrush>
                                <Border x:Name="Knob" Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                    <Border.Background><SolidColorBrush Color="#636363"/></Border.Background>
                                </Border>
                            </Border>
                            <ContentPresenter VerticalAlignment="Top"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin" To="23,0,0,0" Duration="0:0:0.14">
                                                <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                            <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Background.Color" To="#F2F2F2" Duration="0:0:0.14"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="BorderBrush.Color" To="#F2F2F2" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin" To="3,0,0,0" Duration="0:0:0.14">
                                                <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                            <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Background.Color" To="#636363" Duration="0:0:0.14"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="BorderBrush.Color" To="#636363" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The loading screen's line: a thin track with a white fill. -->
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#3A3A3A"/>
                            <Border x:Name="PART_Indicator" Background="#F2F2F2" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
