<Window x:Class="Pentecost.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pentecost.Installer"
        Title="Pentecost" Width="680" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource Text}"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="app.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Margin="16" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:DitherBackdrop Grid.RowSpan="2"/>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <local:PixelLogo Pixel="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <local:Wordmark Text="PENTECOST" Pixel="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource Cap}" Margin="14,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource Chrome}" Click="Min_Click" ToolTip="Minimise">
                        <Path Data="M0,0 L10,0" Stroke="{StaticResource Muted}" StrokeThickness="1" Margin="0,8,0,0"/>
                    </Button>
                    <Button Style="{StaticResource Chrome}" Click="Close_Click" ToolTip="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Muted}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Line}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="42,30,42,32">

                <Grid x:Name="HomePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <local:PixelLogo Pixel="3" Margin="0,0,15,0" VerticalAlignment="Top"/>
                            <local:Wordmark x:Name="HomeWord" Text="INSTALL" Pixel="3" VerticalAlignment="Top" Margin="0,-3,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="HomeSub" Margin="0,18,0,0" FontSize="14" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,26,0,0">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MINECRAFT FOLDER" Style="{StaticResource Cap}"/>
                                    <TextBlock x:Name="FolderText" FontSize="13.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Change" Style="{StaticResource Ghost}" Padding="16,7" FontSize="13"
                                        VerticalAlignment="Center" Click="Change_Click"/>
                            </Grid>
                        </Border>
                        <CheckBox x:Name="WorldsBox" IsChecked="True" Margin="2,24,0,0">
                            <StackPanel>
                                <TextBlock x:Name="WorldsTitle" FontSize="14"/>
                                <TextBlock x:Name="WorldsNote" Text="Pentecost shows these behind the title screen. You can skip them and run this installer again later."
                                           FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="470"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="ModsBox" IsChecked="True" Margin="2,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="ModsTitle" Text="Add Embeddium and Oculus (video options, borderless, shader packs)" FontSize="14"/>
                                <TextBlock x:Name="ModsNote" Text="Small downloads from Modrinth. Skipped if you already have them. You can also add them later from the Video page."
                                           FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="470"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <TextBlock Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,18" FontSize="12.5" Foreground="{StaticResource Faint}"
                               Text="Minecraft and Forge are not part of this installer. Pentecost downloads them the first time you press Play."/>
                    <Grid Grid.Row="3">
                        <Button x:Name="UninstallBtn" Content="Uninstall" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="Uninstall_Click"/>
                        <Button x:Name="InstallBtn" Content="Install" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Install_Click"/>
                    </Grid>
                </Grid>

                <Grid x:Name="ConfirmPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:PixelLogo Pixel="3" Margin="0,0,15,0" VerticalAlignment="Top"/>
                            <local:Wordmark Text="REMOVE" Pixel="3" VerticalAlignment="Top" Margin="0,-3,0,0"/>
                        </StackPanel>
                        <TextBlock Margin="0,18,0,0" FontSize="14" Foreground="{StaticResource Muted}" LineHeight="22"
                                   Text="This removes the Pentecost profile from the Minecraft Launcher and deletes the program files. Your worlds, mods and settings stay in the Pentecost game folder."/>
                        <CheckBox x:Name="RemoveDataBox" Margin="2,28,0,0">
                            <TextBlock FontSize="14" Text="Also delete my Pentecost worlds, mods and settings"/>
                        </CheckBox>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Button Content="Back" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="Back_Click"/>
                        <Button Content="Remove" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="ConfirmRemove_Click"/>
                    </Grid>
                </Grid>

                <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" Margin="0,-10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <local:PixelLogo Pixel="3" Margin="0,0,15,0" VerticalAlignment="Top"/>
                            <local:Wordmark x:Name="ProgWord" Text="INSTALLING" Pixel="3" VerticalAlignment="Top" Margin="0,-3,0,0"/>
                        </StackPanel>
                        <Border Height="1" Margin="0,38,0,0"/>
                        <ProgressBar x:Name="Bar" Style="{StaticResource Bar}"/>
                        <Grid Margin="0,14,0,0">
                            <TextBlock x:Name="ProgTitle" FontSize="14" HorizontalAlignment="Left" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                            <TextBlock x:Name="ProgPercent" Style="{StaticResource Cap}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="ProgDetail" Margin="0,6,0,0" FontSize="12.5" Foreground="{StaticResource Faint}" Height="20" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="DonePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:PixelLogo Pixel="3" Margin="0,0,15,0" VerticalAlignment="Top"/>
                            <local:Wordmark Text="DONE" Pixel="3" VerticalAlignment="Top" Margin="0,-3,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="DoneTitle" Margin="0,20,0,0" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DoneBody" Margin="0,12,0,0" FontSize="14" Foreground="{StaticResource Muted}" LineHeight="24"/>
                        <Border x:Name="DoneWarnBox" Margin="0,18,0,0" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="14,10"
                                Visibility="{Binding Visibility, ElementName=DoneWarn}">
                            <TextBlock x:Name="DoneWarn" FontSize="13" Foreground="{StaticResource Soft}" Visibility="Collapsed"/>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Button x:Name="ModsBtn" Content="Open mods folder" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="OpenMods_Click"/>
                        <Button Content="Close" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Close_Click"/>
                    </Grid>
                </Grid>

                <Grid x:Name="ErrorPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:PixelLogo Pixel="3" Margin="0,0,15,0" VerticalAlignment="Top"/>
                            <local:Wordmark Text="STOPPED" Pixel="3" VerticalAlignment="Top" Margin="0,-3,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ErrTitle" Text="This did not finish" Margin="0,20,0,0" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ErrBody" Margin="0,12,0,0" FontSize="14" Foreground="{StaticResource Soft}" LineHeight="23"/>
                        <TextBlock x:Name="ErrLog" Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource Faint}"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Button Content="Back" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="Back_Click"/>
                        <Button Content="Retry" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Retry_Click"/>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
