<Window x:Class="Pentecost.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pentecost" Width="640" Height="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="app.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Margin="16" CornerRadius="16" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="22" Height="22" Margin="0,0,10,0"/>
                    <TextBlock Text="Pentecost" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionLabel" FontSize="13" Foreground="{StaticResource Muted}" Margin="10,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource Chrome}" Click="Min_Click" ToolTip="Minimise">
                        <Path Data="M0,0 L10,0" Stroke="{StaticResource Muted}" StrokeThickness="1.4" Margin="0,8,0,0"/>
                    </Button>
                    <Button Style="{StaticResource Chrome}" Click="Close_Click" ToolTip="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Muted}" StrokeThickness="1.4"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="36,6,36,30">

                <!-- Home -->
                <Grid x:Name="HomePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="HomeTitle" Text="Install Pentecost" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HomeSub" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <Border Background="{StaticResource Card}" CornerRadius="12" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Minecraft folder" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="FolderText" FontSize="13.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Change" Style="{StaticResource Ghost}" Padding="14,6" FontSize="13"
                                        VerticalAlignment="Center" Click="Change_Click"/>
                            </Grid>
                        </Border>
                        <CheckBox x:Name="WorldsBox" IsChecked="True" Margin="2,20,0,0">
                            <StackPanel>
                                <TextBlock x:Name="WorldsTitle" FontSize="14"/>
                                <TextBlock Text="Pentecost shows these behind the title screen. You can skip them and run this installer again later."
                                           FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" MaxWidth="470"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <TextBlock Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,18" FontSize="12.5" Foreground="{StaticResource Muted}"
                               Text="Minecraft and Forge are not part of this installer. Pentecost downloads them the first time you press Play."/>
                    <Grid Grid.Row="3">
                        <Button x:Name="UninstallBtn" Content="Uninstall" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="Uninstall_Click"/>
                        <Button x:Name="InstallBtn" Content="Install" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Install_Click"/>
                    </Grid>
                </Grid>

                <!-- Remove? -->
                <Grid x:Name="ConfirmPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Remove Pentecost?" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource Muted}" LineHeight="21"
                                   Text="This removes the Pentecost profile from the Minecraft Launcher and deletes the program files. Your worlds, mods and settings stay in the Pentecost game folder."/>
                        <CheckBox x:Name="RemoveDataBox" Margin="2,26,0,0">
                            <TextBlock Foreground="{StaticResource Bad}" FontSize="14" Text="Also delete my Pentecost worlds, mods and settings"/>
                        </CheckBox>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Button Content="Back" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="Back_Click"/>
                        <Button Content="Remove" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="ConfirmRemove_Click"/>
                    </Grid>
                </Grid>

                <!-- Working -->
                <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ProgTitle" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProgDetail" Margin="0,8,0,24" FontSize="13.5" Foreground="{StaticResource Muted}" Height="20" TextWrapping="NoWrap"/>
                        <ProgressBar x:Name="Bar" Style="{StaticResource Bar}"/>
                        <TextBlock x:Name="ProgPercent" Margin="0,10,0,0" FontSize="12.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Done -->
                <Grid x:Name="DonePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Width="46" Height="46" CornerRadius="23" Background="#173A2B" HorizontalAlignment="Left">
                            <Path Data="M0,6 L5,11 L14,0" Stroke="{StaticResource Good}" StrokeThickness="3" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="DoneTitle" Margin="0,16,0,0" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DoneBody" Margin="0,12,0,0" FontSize="14" Foreground="{StaticResource Muted}" LineHeight="23"/>
                        <TextBlock x:Name="DoneWarn" Margin="0,14,0,0" FontSize="13" Foreground="#FFC15E" Visibility="Collapsed"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Button x:Name="ModsBtn" Content="Open mods folder" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="OpenMods_Click"/>
                        <Button Content="Close" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Close_Click"/>
                    </Grid>
                </Grid>

                <!-- Problem -->
                <Grid x:Name="ErrorPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ErrTitle" Text="This did not finish" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Bad}"/>
                        <TextBlock x:Name="ErrBody" Margin="0,14,0,0" FontSize="14" Foreground="{StaticResource Text}" LineHeight="23"/>
                        <TextBlock x:Name="ErrLog" Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Button Content="Back" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="Back_Click"/>
                        <Button Content="Retry" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Retry_Click"/>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
