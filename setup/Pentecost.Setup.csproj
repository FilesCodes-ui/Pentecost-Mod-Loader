<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Pentecost-Setup</AssemblyName>
    <RootNamespace>Pentecost.Setup</RootNamespace>
    <ApplicationIcon>..\manager_new\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Pentecost</Product>
    <Description>Pentecost Setup</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Page Include="..\manager_new\Theme.xaml" Link="Theme.xaml" />
    <Compile Include="..\manager_new\Pixels.cs" Link="Shared\Pixels.cs" />
    <Compile Include="..\manager_new\Blocks.cs" Link="Shared\Blocks.cs" />
    <Compile Include="..\manager_new\Field.cs" Link="Shared\Field.cs" />
    <Resource Include="..\manager_new\app.ico" Link="app.ico" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
